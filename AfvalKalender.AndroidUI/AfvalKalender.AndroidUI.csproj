<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
		<AndroidApplication>true</AndroidApplication>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);1591;NU1605</NoWarn>

        <ApplicationTitle>AfvalKalender</ApplicationTitle>

        <ApplicationId>com.companyname.afvalkalender</ApplicationId>

        <ApplicationVersion>2</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>

        <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
        <PackageReference Include="Ical.Net" Version="5.2.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <!-- Infrastructure pins this package for security fixes (#17). It only ships Linux (glibc) natives;
             NuGet falls back from android-* to linux-x64 and packages a libe_sqlite3.so that cannot load
             on Android. Exclude its natives so the Android build uses its own SQLite library. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" ExcludeAssets="native" />
    </ItemGroup>

    <ItemGroup>
        <!-- App icon: MAUI renders the shared logo into all launcher densities (adaptive icon). -->
        <MauiIcon Include="..\assets\logo.svg" Link="Resources\AppIcon\logo.svg" Color="#2E7D32" ForegroundScale="0.65" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AfvalKalender.Application\AfvalKalender.Application.csproj" />
        <ProjectReference Include="..\AfvalKalender.Domain\AfvalKalender.Domain.csproj" />
        <ProjectReference Include="..\AfvalKalender.Infrastructure\AfvalKalender.Infrastructure.csproj" />
    </ItemGroup>

</Project>