<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AfvalKalender.DesktopUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="using:AfvalKalender.Domain.ValueObjects"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="550"
        x:Class="AfvalKalender.DesktopUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AfvalKalender Exporteur"
        Width="450" Height="800"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="15">
        <Border Background="#2E7D32" CornerRadius="10" Padding="15">
            <StackPanel HorizontalAlignment="Center">
                <Path Data="M 75,20 L 90,45 H 80 V 70 H 70 V 45 H 60 L 75,20 M 35,50 L 55,40 V 48 H 80 V 58 H 55 V 66 L 35,50 M 20,80 L 35,55 H 25 V 30 H 15 V 55 H 5 L 20,80"
                      Fill="White"
                      Width="40" Height="40"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"/>
                <TextBlock Text="AFVAL KALENDER EXPORTEUR"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="[ XIMMIO AFVALVERWERKERS ]"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Spacing="5">
            <TextBlock Text="Afvalverwerker"/>
            <ComboBox ItemsSource="{Binding AfvalVerwerkers}"
                      SelectedItem="{Binding GeselecteerdeVerwerker}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:AfvalVerwerker">
                        <TextBlock Text="{Binding Naam}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Postcode"/>
            <TextBox Text="{Binding Postcode}" PlaceholderText="bijv. 1234AB"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Huisnummer"/>
            <TextBox Text="{Binding Huisnummer}" PlaceholderText="bijv. 10"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Jaar"/>
            <NumericUpDown Value="{Binding Jaar}" Minimum="2020" Maximum="2100"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Herinnering (uren vooraf)"/>
            <NumericUpDown Value="{Binding HerinneringUur}" Minimum="0" Maximum="48"/>
        </StackPanel>

        <Separator Height="2" Margin="0,5"/>
        <TextBlock Text="WebDAV / CalDAV Sync (Optioneel)" FontWeight="Bold" />

        <StackPanel Spacing="5">
            <TextBlock Text="WebDAV URL (bijv. https://caldav.domein.nl)"/>
            <TextBox Text="{Binding WebDavUrl}" PlaceholderText="Laat leeg om alleen lokaal te exporteren"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Gebruikersnaam"/>
            <TextBox Text="{Binding WebDavGebruiker}" />
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Wachtwoord / App-specifiek wachtwoord"/>
            <TextBox Text="{Binding WebDavWachtwoord}" PasswordChar="*" />
        </StackPanel>

        <Button Command="{Binding VerwerkCommand}" 
                IsEnabled="{Binding !IsBezig}"
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#2E7D32" 
                Foreground="White"
                Height="40">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Exporteren naar ICS"/>
                <ProgressBar IsIndeterminate="True" 
                             Width="20" Height="20" 
                             IsVisible="{Binding IsBezig}"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Separator Height="2" Margin="0,10"/>

        <TextBlock Text="{Binding StatusBericht}" 
                   TextWrapping="Wrap" 
                   FontStyle="Italic"
                   HorizontalAlignment="Center"
                   Foreground="{Binding IsBezig, Converter={StaticResource BoolToBrushConverter}}" />

        <Button Command="{Binding OpenBestandCommand}"
                IsVisible="{Binding HeeftResultaat}"
                HorizontalAlignment="Center"
                Classes="link"
                Margin="0,5,0,0">
            <TextBlock Text="Open ICS bestand" 
                       TextDecorations="Underline" 
                       Foreground="Blue"
                       Cursor="Hand"/>
        </Button>
    </StackPanel>
</Window>
